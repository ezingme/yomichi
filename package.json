{
  "name": "yomichi-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0-alpha.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npm run build -w @yomichi/playground",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "node --env-file-if-exists=.env --import tsx packages/server/src/main.ts",
    "playground": "npm run dev -w @yomichi/playground",
    "cli": "node --env-file-if-exists=.env --import tsx packages/cli/src/main.ts",
    "import:jmdict": "node --env-file-if-exists=.env --import tsx packages/dictionary/src/import-cli.ts jmdict",
    "import:kanji": "node --env-file-if-exists=.env --import tsx packages/dictionary/src/import-cli.ts kanji",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/dictionary/src/migrate.ts",
    "bench": "node --env-file-if-exists=.env --import tsx scripts/bench.ts",
    "db:manage": "node --env-file-if-exists=.env --import tsx packages/dictionary/src/manage-cli.ts",
    "parity": "node --env-file-if-exists=.env --import tsx scripts/parity.ts",
    "parity:jmdict": "node --import tsx scripts/evaluate-jmdict.ts",
    "import:ichiran": "node --max-old-space-size=6144 --env-file-if-exists=.env --import tsx packages/dictionary/src/ichiran-import-cli.ts jmdict",
    "import:ichiran-db": "node --env-file-if-exists=.env --import tsx packages/dictionary/src/ichiran-import-cli.ts database",
    "demo:api": "node --env-file-if-exists=.env --import tsx scripts/demo/api-cases.ts",
    "demo:screenshots": "node --import tsx scripts/demo/screenshots.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "saxes": "^6.0.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
