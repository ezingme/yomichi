DATABASE_URL=postgresql://yomichi:yomichi-local@localhost:5432/yomichi
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT=60
# Optional private API authentication. Do not put this key in frontend VITE_* variables.
API_KEY=
# Optional: analyze with an existing Ichiran PostgreSQL database read in place
# (e.g. a restored ichiran release dump). Connections are read-only.
ICHIRAN_DATABASE_URL=
# Version label reported for that database (defaults to its database name).
ICHIRAN_DATABASE_VERSION=
# CLI only:
YOMICHI_API_URL=http://localhost:3000
